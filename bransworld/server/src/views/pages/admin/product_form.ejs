<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= storeName %> · <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/static/css/styles.css" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-dark">
      <div class="container">
        <a class="navbar-brand" href="/admin">Panel</a>
        <a class="btn btn-outline-light btn-sm" href="/admin">Volver</a>
      </div>
    </nav>

    <main class="container py-4" style="max-width: 720px;">
      <div class="card p-4">
        <h1 class="h4 mb-3"><%= mode === 'create' ? 'Crear' : 'Editar' %> producto</h1>
        <form method="post" action="<%= mode === 'create' ? '/admin/products' : ('/admin/products/' + product.id + '?_method=PUT') %>">
          <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input name="name" class="form-control" value="<%= product.name || '' %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea name="description" class="form-control" rows="3"><%= product.description || '' %></textarea>
          </div>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Precio</label>
              <input name="price" type="number" step="0.01" class="form-control" value="<%= product.price || '' %>" required />
            </div>
            <div class="col-md-8">
              <label class="form-label">Categoría</label>
              <input name="category_name" class="form-control" value="<%= product.category_name || '' %>" placeholder="Hombre, Mujer, ..." />
            </div>
          </div>
          <div class="mb-3 mt-3">
            <label class="form-label">URL de imagen</label>
            <input name="image_url" class="form-control" value="<%= product.image_url || '' %>" />
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-accent">Guardar</button>
            <a class="btn btn-outline-light" href="/admin">Cancelar</a>
          </div>
        </form>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
  </html>

