<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= storeName %> · <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/static/css/styles.css" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
      <div class="container">
        <a class="navbar-brand" href="/">Brans´World</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbars" aria-controls="navbars" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbars">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item"><a class="nav-link" href="/productos">Productos</a></li>
          </ul>
          <div class="d-flex">
            <% if (user) { %>
              <a href="/admin" class="btn btn-outline-light btn-sm me-2">Panel</a>
              <form action="/admin/logout" method="post">
                <button class="btn btn-light btn-sm">Salir</button>
              </form>
            <% } else { %>
              <a href="/login" class="btn btn-light btn-sm">Admin</a>
            <% } %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mt-5 pt-4 py-4">
      <div class="row g-4">
        <div class="col-md-6">
          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="img-fluid rounded" />
        </div>
        <div class="col-md-6">
          <h1 class="h3"><%= product.name %></h1>
          <p class="text-muted">Categoría: <%= product.category_name || 'N/A' %></p>
          <p class="lead">$<%= Number(product.price).toFixed(2) %></p>
          <p><%= product.description %></p>
          <button class="btn btn-accent btn-lg">Añadir al carrito</button>
        </div>
      </div>

      <hr class="my-5" />

      <h2 class="h5 mb-3">También te puede interesar</h2>
      <div data-reco-container data-product-id="<%= product.id %>">
        <div class="text-muted">Cargando recomendaciones...</div>
      </div>
    </main>

    <footer class="footer py-4 mt-5">
      <div class="container text-center text-muted">© <%= new Date().getFullYear() %> Brans´World</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/main.js"></script>
  </body>
  </html>

