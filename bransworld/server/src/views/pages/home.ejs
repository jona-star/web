<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= storeName %> · <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/static/css/styles.css" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
      <div class="container">
        <a class="navbar-brand" href="/">Brans´World</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbars" aria-controls="navbars" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbars">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item"><a class="nav-link" href="/productos">Productos</a></li>
          </ul>
          <div class="d-flex">
            <% if (user) { %>
              <a href="/admin" class="btn btn-outline-light btn-sm me-2">Panel</a>
              <form action="/admin/logout" method="post">
                <button class="btn btn-light btn-sm">Salir</button>
              </form>
            <% } else { %>
              <a href="/login" class="btn btn-light btn-sm">Admin</a>
            <% } %>
          </div>
        </div>
      </div>
    </nav>

    <main class="mt-5 pt-4">
      <section class="hero">
        <div class="hero-content text-center text-white">
          <h1 class="display-3 fw-bold">Oscuro. Minimal. Brans´World.</h1>
          <p class="lead text-muted">Moda contemporánea con estética negra y limpia.</p>
          <a href="/productos" class="btn btn-accent btn-lg">Explorar colección</a>
        </div>
      </section>

      <section class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4">Novedades</h2>
          <a href="/productos" class="text-muted">Ver todo</a>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
          <% products.slice(0,8).forEach(p => { %>
            <div class="col">
              <div class="card h-100">
                <img src="<%= p.image_url %>" class="card-img-top" alt="<%= p.name %>">
                <div class="card-body">
                  <h5 class="card-title"><%= p.name %></h5>
                  <p class="card-text text-muted">$<%= Number(p.price).toFixed(2) %></p>
                  <a class="btn btn-outline-light btn-sm" href="/producto/<%= p.id %>">Ver</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>

    <footer class="footer py-4 mt-5">
      <div class="container text-center text-muted">© <%= new Date().getFullYear() %> Brans´World</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/main.js"></script>
  </body>
  </html>

